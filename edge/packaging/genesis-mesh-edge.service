# genesis-mesh-edge (beta): the Genesis Mesh edge agent (docs/edge.md).
#
# Install the binary as /usr/local/bin/genesis-mesh-edge, create the user
# (useradd --system --no-create-home --shell /usr/sbin/nologin genesis-mesh-edge),
# put the configuration in /etc/genesis-mesh-edge/edge.toml and, for the first
# start, the invite token in /etc/genesis-mesh-edge/invite-token (0600, root).
# The agent enrols on its first start and never writes the token anywhere.
[Unit]
Description=Genesis Mesh edge agent
Documentation=https://github.com/GenesisMeshLabs/sdk-rust/blob/main/docs/edge.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=genesis-mesh-edge
Group=genesis-mesh-edge
ExecStart=/usr/local/bin/genesis-mesh-edge --config /etc/genesis-mesh-edge/edge.toml run
StateDirectory=genesis-mesh-edge
StateDirectoryMode=0700
RuntimeDirectory=genesis-mesh-edge
RuntimeDirectoryMode=0750
ConfigurationDirectory=genesis-mesh-edge
UMask=0077
LoadCredential=invite-token:/etc/genesis-mesh-edge/invite-token
Restart=on-failure
RestartSec=5
# Configuration, not enrolled, enrolment refused, insecure keys: a restart
# does not help.
RestartPreventExitStatus=2 3 4 6
TimeoutStopSec=20

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=yes
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=multi-user.target
